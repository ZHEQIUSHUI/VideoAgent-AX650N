# ---- model services (axllm serve, OpenAI compatible) ----
# Model names are optional: the first model served at each URL is used.
# Context limits are read automatically from /v1/models (prefill_max_token_num / max_token_len);
# older axllm builds that don't report them are measured once and cached in <working_dir>/model_limits.json.
LLM_API_BASE_URL=http://127.0.0.1:8012/v1
VLM_API_BASE_URL=http://127.0.0.1:8011/v1
EMBEDDING_API_BASE_URL=http://127.0.0.1:8010/v1
# LLM_MODEL_NAME=AXERA-TECH/Qwen3-1.7B
# LLM_MAX_PREFILL_TOKENS=2176      # override the detected limits only if you must
# LLM_MAX_CONTEXT_TOKENS=2559
# LLM_DISABLE_THINKING=1        # send enable_thinking=false to the LLM (never to the VLM)

# ---- ASR (SenseVoice server, POST /asr/file). Leave empty to index without speech ----
ASR_API_BASE_URL=http://127.0.0.1:8013

# ---- optional: exact token counting (pip install tokenizers) ----
# TOKENIZER_JSON=/path/to/Qwen3-1.7B/tokenizer.json

# ---- indexing ----
VIDEOAGENT_WORKING_DIR=./working_dir
VIDEOAGENT_SEGMENT_SECONDS=10
VIDEOAGENT_MAX_FRAMES_PER_SEGMENT=5      # upper bound; the real number follows from the VLM prefill limit
VIDEOAGENT_FRAME_MAX_SIDE=448
VIDEOAGENT_CAPTION_MAX_TOKENS=256
VIDEOAGENT_CHAPTER_MAX_SEGMENTS=6        # segments per chapter summary
VIDEOAGENT_CHAPTER_TOKENS=200

# ---- query ----
VIDEOAGENT_TOP_K=4
VIDEOAGENT_SCORE_THRESHOLD=0.2
VIDEOAGENT_REFINE_TOP_N=1                # re-watch the best hit with the VLM (0 = off, faster)
VIDEOAGENT_ANSWER_MAX_TOKENS=512
